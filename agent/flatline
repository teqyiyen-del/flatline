import getpass
import glob
import http.client
import pwd
import secrets
import json
import os
import re
import shutil
import socket
import ssl
import stat
import threading
import subprocess  # only fixed argument lists, never a shell  # nosec B404
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from concurrent.futures import ThreadPoolExecutor, wait

VERSION = "0.3.1"
CONF = "/etc/flatline.conf"
STATE = "/var/lib/flatline/state.json"
REMOTE_DEADLINE = 30  # seconds for all site and peer checks together
TOKEN_RE = re.compile(r"\d{5,16}:[A-Za-z0-9_-]{30,64}")
CHAT_RE = re.compile(r"-?\d{1,20}")
KEY_RE = re.compile(r"ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAI[A-Za-z0-9+/]{43}")  # an ed25519 public key, nothing else
NAME_RE = re.compile(r"[A-Za-z0-9._-]{1,40}")
UNIT_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9:_.-]*(@[A-Za-z0-9:_-][A-Za-z0-9:_.-]*)?")  # never an option or a bare "name@"
ERROR_RE = re.compile(r"\b(error|exception|traceback|fatal|panic)\b", re.I)  # log lines are counted, never shown
STATUS_RE = re.compile(r'\] "(?:[^"\\]|\\.)*" (\d{3}) ')  # the status after the request, in which Apache writes " as \"
CACHE_FOR = 1800  # seconds watch mode reuses a certificate or search-engine result
SEEN = {}  # what watch mode remembers between checks: restart counts, log positions, cached site results
DETAILS = ("pm2", "docker", "sites", "services", "updates", "reboot")  # shown on the server's page in the Mac app
SHARE_USER, SHARE_HOME = "flatline", "/var/lib/flatline-share"
LIMITS = {"INTERVAL": (10, 3600), "DISK_MAX": (1, 100), "RAM_MAX": (1, 100), "CERT_DAYS": (0, 365),
          "LOG_ERRORS_MAX": (0, 1_000_000), "HTTP_ERRORS_MAX": (1, 1_000_000)}
TEMPLATE = """\
# Flatline agent config (root only). Apply changes with: sudo systemctl restart flatline
NAME=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Alert when usage reaches these percentages
DISK_MAX=90
RAM_MAX=90
# Seconds between checks (10-3600)
INTERVAL=60
# Websites to check, comma separated: example.com,https://api.example.com/health
SITES=
# Other servers to watch, comma separated name=host:port. Alerts when they stop answering
PEERS=
# Dead man's switch, pinged every check (healthchecks.io, Uptime Kuma push, ...)
HEARTBEAT_URL=
# Failed systemd units to ignore (regex)
IGNORE_UNITS=motd-news
# Sites to also guard for search engines (noindex, robots.txt, sitemap, HSTS), comma separated
SEO_SITES=
# Warn this many days before a site's certificate expires (0 turns it off)
CERT_DAYS=14
# systemd services that must keep running, comma separated: nginx,postgresql
UNITS=
# Alert when a service in UNITS or a pm2 app logs more error lines than this in one check (0 turns it off)
LOG_ERRORS_MAX=0
# nginx or Apache access log to watch for 5xx and 429 answers: /var/log/nginx/access.log
ACCESS_LOG=
# Alert when one check finds more 5xx (or 429) lines than this
HTTP_ERRORS_MAX=20
# Alert on pending security updates and a needed reboot (yes or no)
MAINTENANCE=yes
"""


def log(message):
    print(message, file=sys.stderr, flush=True)  # lands in journalctl -u flatline


def die(code, message):
    log(message)
    sys.exit(code)


def read(path, limit=1_000_000):
    try:
        with open(path) as f:
            return f.read(limit)
    except OSError:
        return ""


def parse(text):
    pairs = (line.partition("=") for line in text.splitlines())
    return {k.strip(): v.strip().strip("\"'") for k, eq, v in pairs if eq and not k.lstrip().startswith("#")}


def load_conf():
    defaults = parse(TEMPLATE)
    conf = dict(defaults)
    conf.update({k: v for k, v in parse(read(CONF)).items() if k in defaults and v})  # unknown keys are ignored
    conf["NAME"] = conf["NAME"] or socket.gethostname()
    for key, (low, high) in LIMITS.items():
        try:
            value = float(conf[key])
            if value != value:  # nan slips past min and max
                raise ValueError
            conf[key] = min(max(value, low), high)
        except ValueError:
            log(f"bad {key} in {CONF}, using {defaults[key]}")
            conf[key] = float(defaults[key])
    try:
        conf["IGNORE_RE"] = re.compile(conf["IGNORE_UNITS"] or "(?!)")
    except re.error:
        log(f"bad IGNORE_UNITS in {CONF}, ignoring nothing")
        conf["IGNORE_RE"] = re.compile("(?!)")
    conf["UNIT_LIST"] = []
    for name in filter(None, (u.strip() for u in conf["UNITS"].split(","))):
        typed = re.search(r"\.(service|socket|target|timer|path|mount|automount|swap|slice|scope|device)$", name)
        unit = name if typed else name + ".service"
        if not UNIT_RE.fullmatch(unit) or len(unit) > 255:  # what systemd would refuse fails every unit's query
            log(f"bad unit name {name!r} in UNITS in {CONF}, skipping it")
            continue
        conf["UNIT_LIST"].append(unit)
    if conf["MAINTENANCE"].lower() not in ("yes", "no"):
        log(f"bad MAINTENANCE in {CONF}, using yes")
    conf["MAINTENANCE"] = conf["MAINTENANCE"].lower() != "no"
    return conf


def save_conf(values):
    if any(ch in str(v) for v in values.values() for ch in "\r\n\0"):
        raise ValueError("config values can't contain line breaks")
    lines = (read(CONF) or TEMPLATE).splitlines()
    for key, value in values.items():
        at = [i for i, line in enumerate(lines) if line.partition("=")[0].strip() == key]
        if at:
            lines[at[0]] = f"{key}={value}"
        else:
            lines.append(f"{key}={value}")
    fd = os.open(CONF + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    os.fchmod(fd, 0o600)  # holds the bot token
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(CONF + ".tmp", CONF)


def vitals():
    def cpu_ticks():
        t = [int(x) for x in read("/proc/stat").splitlines()[0].split()[1:]]
        return t[3] + t[4], sum(t)  # idle + iowait, total

    idle1, total1 = cpu_ticks()
    time.sleep(0.3)
    idle2, total2 = cpu_ticks()
    mem = {k: int(v.split()[0]) for k, v in (line.split(":", 1) for line in read("/proc/meminfo").splitlines())}
    total, available = mem["MemTotal"], mem["MemAvailable"]  # kB
    disk = shutil.disk_usage("/")
    return {
        "cpu": round(100 * (1 - (idle2 - idle1) / max(total2 - total1, 1)), 1),
        "ram": round(100 * (1 - available / total), 1),
        "disk": round(100 * disk.used / (disk.used + disk.free), 1),
        "load": [round(x, 2) for x in os.getloadavg()],
        "cores": os.cpu_count(),
        "uptime": int(float(read("/proc/uptime").split()[0])),
        "mem_used": (total - available) // 1024, "mem_total": total // 1024,  # MB
        "disk_used": round(disk.used / 1e9, 1), "disk_total": round((disk.used + disk.free) / 1e9, 1),  # GB
    }


def run(*cmd, check=True):
    """Runs a fixed command. "" when the program isn't installed; raises when it fails, so checks stay loud."""
    try:
        done = subprocess.run(cmd, capture_output=True, text=True, timeout=20)  # fixed argv  # nosec B603
    except FileNotFoundError:
        return ""
    if check and done.returncode != 0:
        raise RuntimeError(f"{cmd[0]} exited with {done.returncode}")
    return done.stdout


def note(v, problem, text):
    """Attaches a short note, like "HTTP 404", shown next to the problem in its alert. Never a secret or log text."""
    v.setdefault("notes", {})[problem] = text
    return problem


def new_lines(path):
    """Yields the lines added to a log since the previous check: 50 MB at most, 1 MB at a time so memory stays small.
    The first check only notes where the log ends. Only a regular file is read: a FIFO could hold the watch forever."""
    with open(os.open(path, os.O_RDONLY | os.O_NONBLOCK), "rb") as f:  # opening a FIFO doesn't wait for a writer
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode):
            raise ValueError(f"{path} is not a regular file")
        inode, offset, partial = SEEN.get(("log", path), (st.st_ino, st.st_size, b""))
        if inode != st.st_ino or st.st_size < offset:
            offset, partial = 0, b""  # rotated or truncated: read the new log from its start
        f.seek(offset)
        for block in iter(lambda: f.read(1_000_000), b""):
            *complete, partial = (partial + block).split(b"\n")
            partial = partial[:65536]  # a line with no end in sight is cut, not kept whole
            yield from (line.decode("utf-8", "replace") for line in complete)
            if f.tell() - offset >= 50_000_000:
                break
        SEEN[("log", path)] = (st.st_ino, f.tell(), partial)  # an unfinished last line waits for the next check


def thresholds(conf, v):
    return [f"{what} above {conf[key]:g}%" for what, key in (("disk", "DISK_MAX"), ("ram", "RAM_MAX"))
            if v[what] >= conf[key]]


def units(conf, v):
    out = run("systemctl", "list-units", "--state=failed", "--no-legend", "--plain")
    names = (line.split()[0] for line in out.splitlines() if line.strip())
    return [f"{name} failed" for name in names if not conf["IGNORE_RE"].search(name)]


def services(conf, v):
    names = conf["UNIT_LIST"]
    if not names:
        return []
    out = run("systemctl", "show", "--property=LoadState,ActiveState,SubState,NRestarts", "--", *names)
    blocks = out.strip().split("\n\n")
    if len(blocks) != len(names):
        raise ValueError("systemctl show answered for a different number of units")
    found, details = [], []
    for name, block in zip(names, blocks):
        p = parse(block)
        state = "not found" if p.get("LoadState") == "not-found" else f"{p.get('ActiveState')} ({p.get('SubState')})"
        restarts, before = int(p.get("NRestarts") or 0), SEEN.get(("restarts", name))
        SEEN[("restarts", name)] = restarts
        details.append({"name": name, "state": state, "restarts": restarts})
        active = p.get("ActiveState")
        # a failed unit is already reported by the units check, unless IGNORE_UNITS hides it there
        if state == "not found" or active not in ("active", "reloading") and (
                active != "failed" or conf["IGNORE_RE"].search(name)):
            found.append(note(v, f"service {name} not running", state))
        if before is not None and restarts > before:  # the first check only notes the count
            found.append(note(v, f"service {name} restarting", f"{restarts - before} restarts"))
    v["services"] = details[:50]  # shown on the server's page in the Mac app
    return found


def journal(conf, v):
    found = []
    for name in conf["UNIT_LIST"] if conf["LOG_ERRORS_MAX"] else []:
        out = run("journalctl", f"--unit={name}", f"--since=-{int(conf['INTERVAL'])}s", "--output=json",
                  "--output-fields=PRIORITY,MESSAGE", "--lines=20000", "--no-pager", "--quiet")
        entries = (json.loads(line) for line in out.splitlines() if line.strip())  # one at a time, never all at once
        count = sum(1 for e in entries if e.get("PRIORITY") in ("0", "1", "2", "3")  # err, crit, alert, emerg
                    or isinstance(e.get("MESSAGE"), str) and ERROR_RE.search(e["MESSAGE"]))
        if count > conf["LOG_ERRORS_MAX"]:
            found.append(note(v, f"service {name} logging errors", f"{count} lines"))
    return found


def pm2(conf, v):
    pid = read(os.path.expanduser("~/.pm2/pm2.pid")).strip()
    if not pid:
        return []  # pm2 isn't used here
    try:
        os.kill(int(pid), 0)
    except ProcessLookupError:
        return ["pm2 daemon not running"]  # calling pm2 now would start an empty one
    except PermissionError:
        pass  # the pid exists
    out = run("pm2", "jlist")
    start = re.search(r"\[\s*[{\]]", out)  # skip "[PM2] ..." notices printed around the JSON
    if not start:
        raise ValueError("pm2 jlist printed no JSON")
    data, _ = json.JSONDecoder().raw_decode(out, start.start())
    apps = [{"name": p["name"], "status": p["pm2_env"]["status"], "cpu": p.get("monit", {}).get("cpu", 0),
             "mem": p.get("monit", {}).get("memory", 0) // 1048576, "restarts": p["pm2_env"].get("restart_time", 0)}
            for p in data]
    v["pm2"] = apps[:50]  # shown on the server's page in the Mac app
    found = [f"pm2 {a['name']} down" for a in apps if a["status"] != "online"]  # one name, whatever the status
    if conf["LOG_ERRORS_MAX"]:
        errors = {}
        for p in data:  # instances of one app share its name, and often its log
            path = p["pm2_env"].get("pm_err_log_path")
            if not isinstance(path, str) or path == os.devnull:  # error_file /dev/null turns the log off
                continue
            try:  # a log Flatline can't read fails the check loudly
                errors[p["name"]] = errors.get(p["name"], 0) + sum(1 for line in new_lines(path) if ERROR_RE.search(line))
            except FileNotFoundError:
                pass  # nothing logged yet
        found += [note(v, f"pm2 {name} logging errors", f"{n} lines") for name, n in errors.items()
                  if n > conf["LOG_ERRORS_MAX"]]
    return found


def docker(conf, v):
    # as root a failing docker is loud; without root (a no-install check over SSH) it is only out of sight
    out = run("docker", "ps", "-a", "--format", "{{.Names}}\t{{.State}}\t{{.Status}}", check=os.geteuid() == 0)
    boxes = [dict(zip(("name", "state", "status"), (line.split("\t") + ["", ""])[:3])) for line in out.splitlines()]
    v["docker"] = boxes[:50]  # shown on the server's page in the Mac app
    found = []
    for box in boxes:
        if box["state"] == "restarting" or "(unhealthy)" in box["status"]:
            found.append(f"docker {box['name']} unhealthy")  # one name, so flapping can't spam alerts
    return found


def site_label(spec):
    """host/path only: no user:password, query or fragment in alerts or the world-readable state."""
    parts = urllib.parse.urlsplit(spec if "://" in spec else "https://" + spec)
    return (parts.hostname or "?") + parts.path


class Redirects(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        """Follows redirects to http(s) only; urllib on its own would also follow one to ftp."""
        if urllib.parse.urlsplit(newurl).scheme in ("http", "https"):
            return super().redirect_request(req, fp, code, msg, headers, newurl)
        return None


OPENER = urllib.request.build_opener(Redirects)


def fetch(url, limit=0, timeout=10):
    """GETs an http(s) URL: (status, final url, headers, up to `limit` bytes of body). An HTTP error is an answer too."""
    request = urllib.request.Request(url, headers={"User-Agent": "flatline"})
    try:
        with OPENER.open(request, timeout=timeout) as r:  # callers only pass http(s)  # nosec B310
            return r.status, r.url, r.headers, r.read(limit) if limit else b""
    except urllib.error.HTTPError as e:
        return e.code, e.filename, e.headers, b""


def answer(url, limit=0):
    """A site's page: ("HTTP 200", (final url, headers, body)), or ("timeout" | "no answer" | "certificate error", None)."""
    try:
        status, final, headers, body = fetch(url, limit)
        return f"HTTP {status}", (final, headers, body)
    except urllib.error.URLError as e:
        if isinstance(e.reason, ssl.SSLError):
            return "certificate error", None
        return ("timeout" if isinstance(e.reason, socket.timeout) else "no answer"), None
    except socket.timeout:
        return "timeout", None
    except Exception:  # broken HTTP, anything else
        return "no answer", None


def up(status):
    """Any answer below 400 is up, and so are login walls (401, 403)."""
    return status.startswith("HTTP ") and (int(status[5:]) < 400 or status in ("HTTP 401", "HTTP 403"))


def cached(key):
    """A result from an earlier check in the last half hour; only watch mode lives long enough to have one."""
    hit = SEEN.get(key)
    return hit[1] if hit and time.time() - hit[0] < CACHE_FOR else None


def cert_days(host, port):
    """Whole days left on a site's certificate, or None when it can't be read."""
    days = cached(("cert", host, port))
    if days is None:
        try:
            with socket.create_connection((host, port), timeout=5) as raw:
                with ssl.create_default_context().wrap_socket(raw, server_hostname=host) as tls:
                    days = int((ssl.cert_time_to_seconds(tls.getpeercert()["notAfter"]) - time.time()) // 86400)
            SEEN[("cert", host, port)] = (time.time(), days)
        except (OSError, ValueError, KeyError):  # not a problem by itself: the page request reports real TLS trouble
            pass
    return days


def keeps_out(rules):
    """Whether a robots rule list like "noindex, nofollow" or "googlebot: none" says noindex or none."""
    for rule in rules.lower().split(","):
        name, colon, rest = rule.partition(":")
        if colon and not name.strip().startswith(("max-", "unavailable_after")):
            rule = rest  # "googlebot: noindex" names a crawler first; "max-image-preview:none" is its own rule
        if rule.strip() in ("noindex", "none"):
            return True
    return False


def noindex(headers, html):
    """An X-Robots-Tag header or a robots/googlebot meta tag that keeps search engines out."""
    if any(keeps_out(h) for h in headers.get_all("X-Robots-Tag") or []):
        return True
    for tag in re.findall(r"<meta\b[^<>]*>", html, re.I):  # [^<>] keeps a page full of "<meta" from taking minutes
        pairs = re.findall(r"(?<![\w-])(name|content)\s*=\s*(?:\"([^\"]*)\"|'([^']*)'|([^\s\"'>]+))", tag, re.I)
        attrs = {k.lower(): "".join(values) for k, *values in pairs}  # quoted, single-quoted or bare
        if attrs.get("name", "").strip().lower() in ("robots", "googlebot") and keeps_out(attrs.get("content", "")):
            return True
    return False


def robots(text, origin):
    """Reads robots.txt: (whether a group for every crawler says "Disallow: /", the sitemap URL to check)."""
    agents, rules, blocked, sitemap = [], False, False, None
    for line in text.splitlines():
        field, colon, value = line.split("#", 1)[0].partition(":")
        field, value = field.strip().lower(), value.strip()
        if field == "user-agent":
            agents = ([] if rules else agents) + [value]  # a user-agent line after rules starts a new group
            rules = False
        elif field == "sitemap":
            sitemap = value if sitemap is None else sitemap
        elif colon:
            rules = True
            blocked = blocked or (field == "disallow" and value == "/" and "*" in agents)
    try:
        scheme = urllib.parse.urlsplit(sitemap or "").scheme
    except ValueError:  # a broken Sitemap line, like "https://[example.com/s.xml"
        scheme = ""
    return blocked, sitemap if scheme in ("http", "https") else origin + "/sitemap.xml"


EXTRAS = ("robots.txt blocks crawlers", "sitemap missing")  # what the extra requests find, not the page


def search_guard(url, final, headers, body, deadline):
    """noindex, robots.txt, sitemap and HSTS for a site's page: ({problem: note}, whether every extra request answered)."""
    label, found = site_label(url), {}
    if noindex(headers, body.decode("utf-8", "replace")):
        found[f"site {label} noindex"] = ""
    if final.startswith("https://") and "Strict-Transport-Security" not in headers:
        found[f"site {label} no HSTS"] = ""
    parts = urllib.parse.urlsplit(final)
    origin = f"{parts.scheme}://{parts.netloc.rpartition('@')[2]}"
    if time.monotonic() > deadline - 10:  # no time left for the extra requests: unknown this time
        return found, False
    try:
        status, _, _, text = fetch(origin + "/robots.txt", 512 * 1024, timeout=5)
        blocked, sitemap = robots(text.decode("utf-8-sig", "replace") if status == 200 else "", origin)
        if blocked:
            found[f"site {label} robots.txt blocks crawlers"] = ""
        status = fetch(sitemap, timeout=5)[0]
        if status != 200:
            found[f"site {label} sitemap missing"] = f"HTTP {status}"
    except (OSError, ValueError, http.client.HTTPException):  # an extra request that fails is unknown, not a problem
        return found, False
    return found, True


def site(url, conf, seo=False, deadline=float("inf"), early=None):
    """Checks one site: (its detail for the Mac app, {problem: note}). The page's own verdict goes into `early`
    before the search-engine extras, so extras that run past the deadline can't make a working site look down."""
    label, parts = site_label(url), urllib.parse.urlsplit(url)
    if parts.scheme not in ("https", "http"):
        return {"site": label, "ok": False, "status": "invalid url", "cert_days": None}, {f"site {label} invalid url": ""}
    guard = cached(("seo", url)) if seo else {}
    limit = 512 * 1024 if guard is None else 0  # the page itself is only read when the search-engine look is due
    status, reply = answer(url, limit)
    if not up(status):
        time.sleep(3)  # ask again before calling it down, so blips stay quiet
        status, reply = answer(url, limit)
    found, days = {}, None
    if status == "certificate error":
        found[f"site {label} certificate error"] = ""
    elif not up(status):
        found[f"site {label} down"] = status
    if status.startswith("HTTP ") and parts.scheme == "https" and conf["CERT_DAYS"] and time.monotonic() < deadline - 5:
        days = cert_days(parts.hostname, parts.port or 443)
        if days is not None and days < conf["CERT_DAYS"]:
            found[f"site {label} certificate expires soon"] = f"in {days} days"
    detail = {"site": label, "ok": up(status), "status": status, "cert_days": days}
    seen_at, last = SEEN.get(("seo", url), (0, {}))  # the last search-engine look, however old
    if early is not None:
        early[url] = (detail, {**found, **last})
    if guard is None and up(status):
        fresh, complete = search_guard(url, *reply, deadline)
        # a request that went unanswered keeps its last answer; noindex and HSTS were just read off the page
        guard = fresh if complete else {**{k: n for k, n in last.items() if k.endswith(EXTRAS)}, **fresh}
        SEEN[("seo", url)] = (time.time() if complete else seen_at, guard)  # unanswered: looks again next check
    found.update(last if guard is None else guard)  # a page that's down keeps the last look
    return detail, found


def peer(spec):
    name, _, addr = spec.rpartition("=")
    if addr.startswith("["):
        host, _, port = addr[1:].partition("]")
        port = port.lstrip(":")
    else:
        host, _, port = addr.partition(":")
    try:
        socket.create_connection((host, int(port or 22)), timeout=5).close()
        return None
    except (OSError, ValueError, OverflowError):
        return f"peer {name or host} unreachable"


def probe(check, spec):
    """Runs a peer check twice before calling it a problem, so blips stay quiet."""
    problem = check(spec)
    if problem:
        time.sleep(3)
        problem = check(spec)
    return problem


def remote(conf, v):
    sites = {}
    for key, seo in (("SITES", False), ("SEO_SITES", True)):
        for spec in filter(None, (s.strip() for s in conf[key].split(","))):
            url = spec if "://" in spec else "https://" + spec
            sites[url] = sites.get(url, False) or seo  # listed in both: checked once, with the extras
    peers = [p.strip() for p in conf["PEERS"].split(",") if p.strip()]
    if not sites and not peers:
        return []
    deadline = time.monotonic() + REMOTE_DEADLINE  # the extras are skipped when it gets close
    pool, early = ThreadPoolExecutor(8), {}
    site_jobs = {url: pool.submit(site, url, conf, seo, deadline, early) for url, seo in sites.items()}
    peer_jobs = {spec: pool.submit(probe, peer, spec) for spec in peers}
    wait([*site_jobs.values(), *peer_jobs.values()], timeout=REMOTE_DEADLINE)
    pool.shutdown(wait=False)  # ponytail: a host that trickles bytes keeps its thread until it gives up
    found = [job.result() if job.done() else f"peer {spec.rpartition('=')[0] or spec} unreachable"
             for spec, job in peer_jobs.items()]
    found, details = [p for p in found if p], []
    for url, job in site_jobs.items():
        label = site_label(url)
        detail, probs = job.result() if job.done() else early.get(url, (  # late extras keep the page's verdict
            {"site": label, "ok": False, "status": "timeout", "cert_days": None}, {f"site {label} down": "timeout"}))
        details.append(detail)
        found += [note(v, problem, text) for problem, text in probs.items()]
    if details:
        v["sites"] = details[:50]  # shown on the server's page in the Mac app
    return found


def access_log(conf, v):
    path = conf["ACCESS_LOG"]
    if not path:
        return []
    if not path.startswith("/"):
        raise ValueError("ACCESS_LOG must be an absolute path")
    codes = [m.group(1) for m in map(STATUS_RE.search, new_lines(path)) if m]
    found = []
    for what, count in (("5xx", sum(c.startswith("5") for c in codes)), ("429", codes.count("429"))):
        if count > conf["HTTP_ERRORS_MAX"]:
            found.append(note(v, f"access log {what} above {conf['HTTP_ERRORS_MAX']:g}", f"{count} in the last check"))
    return found


def maintenance(conf, v):
    if not conf["MAINTENANCE"]:
        return []
    found = []
    text = read("/var/lib/update-notifier/updates-available", 100_000)  # Ubuntu's apt keeps it fresh
    if text:  # anywhere else the count is unknown
        # standard, ESM Infra and ESM Apps updates each get their own line; "can be applied with ESM" ones can't yet
        counts = re.findall(r"(\d+) (?:of these )?updates? (?:is|are) (?:an? )?(?:standard |ESM \w+ )?security", text)
        v["updates"] = sum(map(int, counts))
        if v["updates"]:
            found.append(note(v, "security updates pending", f"{v['updates']} updates"))
    v["reboot"] = os.path.exists("/run/reboot-required")
    if v["reboot"]:
        packages = dict.fromkeys(read("/run/reboot-required.pkgs", 100_000).split())
        found.append(note(v, "reboot required", ", ".join(list(packages)[:3])))
    return found


def problems(conf, v):
    found = []
    for check in (thresholds, units, services, journal, pm2, docker, remote, access_log, maintenance):
        try:
            found += check(conf, v)
        except Exception as e:  # a broken check must be loud, never silently blind
            log(f"{check.__name__} check crashed: {e!r}")
            found.append(f"{check.__name__} check failed")
    return found


def tg(token, method, **params):
    """Calls the Telegram Bot API. Returns the decoded reply, or {} when Telegram can't be reached."""
    try:
        request = urllib.request.Request(f"https://api.telegram.org/bot{token}/{method}",
                                         urllib.parse.urlencode(params).encode())
        with urllib.request.urlopen(request, timeout=15) as r:  # fixed https URL  # nosec B310
            reply = json.loads(r.read(1_000_000))
    except urllib.error.HTTPError as e:  # Telegram explains refusals in the body
        try:
            reply = json.loads(e.read(1_000_000))
        except ValueError:
            return {}
    except (OSError, ValueError):
        return {}
    return reply if isinstance(reply, dict) else {}


def send(token, chat, text):
    return bool(tg(token, "sendMessage", chat_id=chat, text=text[:4000]).get("ok"))


def heartbeat(url):
    def ping():
        try:
            OPENER.open(url, timeout=10).close()  # http(s) checked below, redirects too  # nosec B310
        except Exception:
            pass
    if url.startswith(("https://", "http://")):
        threading.Thread(target=ping, daemon=True).start()  # never holds up a check


def uptime(s):
    return f"{s // 86400}d {s % 86400 // 3600}h" if s >= 86400 else f"{s // 3600}h {s % 3600 // 60}m"


def bullets(items, notes=None):
    notes = notes or {}
    return "\n".join(f"• {p}" + (f" · {notes[p]}" if notes.get(p) else "") for p in sorted(items))


def summary(name, v, probs):
    head = f"{'🔴' if probs else '🟢'} {name} · up {uptime(v['uptime'])}\n"
    body = f"cpu {v['cpu']:.0f}% · ram {v['ram']:.0f}% · disk {v['disk']:.0f}% · load {v['load'][0]}"
    return head + body + ("\n" + bullets(probs) if probs else "")


def tick(conf, state):
    """One check. Alerts on a problem seen on two checks in a row, and on its recovery after two clean checks."""
    v = vitals()
    now, before = set(problems(conf, v)), set(state.get("problems", []))
    alerted = set(state.get("alerted", []))
    new = (now & before) - alerted
    fixed = alerted - now - before  # gone from this check and the one before, so a flapping problem can't spam
    token, chat, name = conf["TELEGRAM_TOKEN"], conf["TELEGRAM_CHAT_ID"], conf["NAME"]
    if token and chat:
        # a failed send leaves the set as it was, so the next check tries again
        if new and send(token, chat, f"🔴 {name}\n{bullets(new, v.get('notes'))}"):
            alerted |= new
        if fixed and send(token, chat, f"✅ {name} recovered\n{bullets(fixed)}"):
            alerted -= fixed
    heartbeat(conf["HEARTBEAT_URL"])
    return {"time": int(time.time()), "name": name, "interval": conf["INTERVAL"], "version": VERSION,
            "problems": sorted(now), "alerted": sorted(alerted),
            "details": {k: v[k] for k in DETAILS if k in v}}


def read_state():
    try:
        return json.loads(read(STATE) or "{}")
    except ValueError:
        return {}


def write_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE + ".tmp", "w") as f:
        json.dump(state, f)
    os.chmod(STATE + ".tmp", 0o644)  # any SSH user can run `flatline status`; no secrets in here
    os.replace(STATE + ".tmp", STATE)


def watch():
    conf, state = load_conf(), read_state()
    log(f"flatline {VERSION} watching {conf['NAME']} every {conf['INTERVAL']:g}s"
        + ("" if conf["TELEGRAM_TOKEN"] else " (Telegram not set up yet: sudo flatline setup)"))
    while True:
        started = time.monotonic()
        try:
            state = tick(conf, state)
            write_state(state)
        except Exception as e:  # never let one bad check stop the watch
            log(f"check failed: {e!r}")
        time.sleep(max(1.0, conf["INTERVAL"] - (time.monotonic() - started)))


def status(as_json, live=False):
    if live:  # nothing installed: check right now, write nothing
        conf, state = load_conf(), {}
        v = vitals()
        probs, name = problems(conf, v), conf["NAME"]
        details = {k: v.pop(k) for k in DETAILS if k in v}
        v.pop("notes", None)  # notes only go into alerts
    else:
        state = read_state()
        probs = list(state.get("problems", []))
        if time.time() - state.get("time", 0) > 3 * state.get("interval", 60):
            probs.append("flatline watch is not running")
        name, v, details = state.get("name") or socket.gethostname(), vitals(), state.get("details", {})
    if as_json:
        system = {"os": parse(read("/etc/os-release")).get("PRETTY_NAME", "Linux"), "kernel": os.uname().release}
        print(json.dumps(dict(v, name=name, problems=probs, agent=not live, version=VERSION, **system, **details)))
    else:
        print(summary(name, v, probs))


def require_root():
    if os.geteuid() != 0:
        die(77, "flatline: run as root: sudo flatline " + sys.argv[1])


def finish(token, chat, name):
    run("systemctl", "try-restart", "flatline", check=False)
    if token and not send(token, chat, f"💓 Flatline is now watching {name}"):
        die(69, f"flatline: saved {CONF}, but this server can't reach Telegram")
    print(f"Saved {CONF}")


def setup():
    require_root()
    try:
        tty = open("/dev/tty")  # works under `curl ... | sudo bash`
    except OSError:
        die(65, "flatline: no terminal here. Run `sudo flatline setup` over SSH, or connect Telegram from the Mac app")
    with tty:
        def ask(question):
            print(question, end=" ", flush=True)
            return tty.readline(200).strip()

        name = re.sub(r"[^\w.-]", "", ask(f"Server name [{socket.gethostname()}]:"))[:64] or socket.gethostname()
        values = {"NAME": name}
        token = getpass.getpass("Telegram bot token from @BotFather (Enter to skip): ").strip()
        if token:
            if not TOKEN_RE.fullmatch(token):
                die(65, "flatline: that isn't a bot token (looks like 123456:ABC...). Run: sudo flatline setup")
            ask("Now send any message to your bot in Telegram, then press Enter.")
            updates = tg(token, "getUpdates").get("result", [])
            chats = [(u.get("message") or {}).get("chat") for u in updates if isinstance(u, dict)]
            chats = [c for c in chats if isinstance(c, dict) and isinstance(c.get("id"), int)]
            if not chats:
                die(65, "flatline: the bot got no message. Message it, then run: sudo flatline setup")
            chat = chats[-1]
            who = chat.get("title") or " ".join(filter(None, (chat.get("first_name"), chat.get("last_name"))))
            who += f" (@{chat['username']})" if chat.get("username") else ""
            if ask(f"Send alerts to {who or chat['id']}? [y/N]").lower() not in ("y", "yes"):
                die(65, "flatline: nothing saved. Message the bot from your own account, then run: sudo flatline setup")
            values.update(TELEGRAM_TOKEN=token, TELEGRAM_CHAT_ID=chat["id"])
    save_conf(values)
    finish(values.get("TELEGRAM_TOKEN"), values.get("TELEGRAM_CHAT_ID"), name)


def telegram():
    require_root()
    token, chat = sys.stdin.readline(200).strip(), sys.stdin.readline(50).strip()
    if not TOKEN_RE.fullmatch(token) or not CHAT_RE.fullmatch(chat):
        die(65, "flatline: expected a bot token and a chat id on stdin")
    save_conf({"TELEGRAM_TOKEN": token, "TELEGRAM_CHAT_ID": chat})
    finish(token, chat, load_conf()["NAME"])


# Read-only sharing. Access is a line in the `flatline` user's authorized_keys that can only ever
# run `flatline status`: `restrict` turns off shells, ttys and forwarding, `command=` pins the command.


def keys_file():
    return os.path.join(SHARE_HOME, ".ssh", "authorized_keys")


def edit_keys(change):
    """Rewrites authorized_keys under a lock, atomically, keeping it private to the flatline user."""
    path = keys_file()
    with open(os.path.join(SHARE_HOME, ".lock"), "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        lines = change([l for l in read(path).splitlines() if l.strip()])
        fd = os.open(path + ".tmp", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write("".join(l + "\n" for l in lines))
        os.replace(path + ".tmp", path)


def share():
    require_root()
    key = " ".join(sys.stdin.readline(300).split()[:2])  # "ssh-ed25519 AAAA…", any comment dropped
    if not KEY_RE.fullmatch(key):
        die(65, "flatline: expected an ed25519 public key on stdin")
    try:
        pwd.getpwnam(SHARE_USER)
    except KeyError:  # a locked system account whose only purpose is to answer `flatline status`
        run("useradd", "--system", "--home-dir", SHARE_HOME, "--create-home", "--shell", "/bin/sh", SHARE_USER)
        run("usermod", "-p", "*", SHARE_USER)  # no password at all, yet not "locked", so sshd accepts its keys
    user = pwd.getpwnam(SHARE_USER)
    os.makedirs(os.path.join(SHARE_HOME, ".ssh"), mode=0o700, exist_ok=True)
    for path in (SHARE_HOME, os.path.join(SHARE_HOME, ".ssh")):
        os.chown(path, user.pw_uid, user.pw_gid)
        os.chmod(path, 0o700)
    invite = secrets.token_hex(8)
    expiry = time.strftime("%Y%m%d%H%M", time.gmtime(time.time() + 86400))
    edit_keys(lambda lines: lines + [f'restrict,command="/usr/local/bin/flatline redeem {invite}",expiry-time="{expiry}Z" '
                                     f"{key} flatline-invite-{invite}"])
    for path in (keys_file(), os.path.join(SHARE_HOME, ".lock")):
        os.chown(path, user.pw_uid, user.pw_gid)
    hostkeys = [read(p).split()[:2] for p in sorted(glob.glob("/etc/ssh/ssh_host_*_key.pub"))]
    print(json.dumps({"user": SHARE_USER, "invite": invite, "hostkeys": [" ".join(k) for k in hostkeys if len(k) == 2]}))


def redeem(invite):
    """Runs as the flatline user with the one-time invite key. Trades it for the guest's own key, once."""
    key, name = " ".join(sys.stdin.readline(300).split()[:2]), sys.stdin.readline(100).strip()
    if not re.fullmatch(r"[0-9a-f]{16}", invite) or not KEY_RE.fullmatch(key) or not NAME_RE.fullmatch(name):
        die(65, "flatline: bad invite")
    marker = f" flatline-invite-{invite}"

    def trade(lines):
        if not any(l.endswith(marker) for l in lines):
            die(65, "flatline: this invite was already used")
        kept = [l for l in lines if not l.endswith(marker)]
        return kept + [f'restrict,command="/usr/local/bin/flatline status --json" {key} flatline-guest-{name}']
    edit_keys(trade)
    print("ok")


def guests():
    return [l.rsplit(" flatline-guest-", 1)[1] for l in read(keys_file()).splitlines() if " flatline-guest-" in l]


def access(as_json):
    require_root()
    names = guests()
    print(json.dumps(names) if as_json else "\n".join(names) or "Nobody else has access.")


def revoke(name):
    require_root()
    if not NAME_RE.fullmatch(name) or name not in guests():
        die(65, f"flatline: no guest called {name}")
    edit_keys(lambda lines: [l for l in lines if not l.endswith(f" flatline-guest-{name}")])
    print(f"{name} can no longer see this server.")


def uninstall():
    require_root()
    run("systemctl", "disable", "--now", "flatline", check=False)
    for path in ("/etc/systemd/system/flatline.service", CONF, CONF + ".tmp", "/usr/local/bin/flatline"):
        try:
            os.remove(path)
        except FileNotFoundError:
            pass
    shutil.rmtree(os.path.dirname(STATE), ignore_errors=True)
    try:
        pwd.getpwnam(SHARE_USER)
        run("userdel", "--remove", SHARE_USER, check=False)  # takes every guest key with it
    except KeyError:
        pass
    shutil.rmtree(SHARE_HOME, ignore_errors=True)
    run("systemctl", "daemon-reload", check=False)
    print("Flatline is gone from this server. Only past journal lines remain, and they rotate away.")


if __name__ == "__main__":
    command = sys.argv[1] if len(sys.argv) > 1 else "status"
    if command == "status":
        status("--json" in sys.argv, live="--live" in sys.argv)
    elif command == "watch":
        watch()
    elif command == "setup":
        setup()
    elif command == "telegram":
        telegram()
    elif command == "share":
        share()
    elif command == "redeem" and len(sys.argv) == 3:
        redeem(sys.argv[2])
    elif command == "access":
        access("--json" in sys.argv)
    elif command == "revoke" and len(sys.argv) == 3:
        revoke(sys.argv[2])
    elif command == "uninstall":
        uninstall()
    elif command in ("-v", "--version"):
        print(VERSION)
    else:
        sys.exit(__doc__)
